# FinMind API Token
# 註冊取得：https://finmindtrade.com/
FINMIND_TOKEN=your_finmind_api_token_here

# FinLab API Token (優先使用)
# 註冊取得：https://ai.finlab.tw/
FINLAB_API_TOKEN=your_finlab_api_token_here

# 資料庫路徑
DATABASE_PATH=data/cache.db

# 除錯模式
DEBUG=True

# Streamlit 設定
PORT=8501

# 數據更新間隔（小時）
UPDATE_INTERVAL_HOURS=4
